# Copy to .env (optional). Everything has a sensible default.

# Port the server listens on (default 3000 with `bun run start`, 4200 in Docker)
PORT=4200

# Database. Default: a local SQLite file at packages/web/data/scheduler.db
# DATABASE_URL=file:/absolute/path/to/scheduler.db
# Or a remote libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Web address people use (for teacher schedule links and emails)
# PUBLIC_URL=https://takda.yourschool.edu.ph

# Email (Teacher Schedule > Share > Email each teacher their schedule)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=scheduler@yourschool.edu.ph
# SMTP_PASS=app-password
# SMTP_FROM="TAKDA Scheduler <scheduler@yourschool.edu.ph>"

# The first admin account can only be created from this machine or the local
# network. Set to 1 to allow it from anywhere (not recommended).
# ALLOW_REMOTE_SETUP=1
