{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "build:hosted": "vite build --config vite.hosted.config.ts",
    "build:artifact": "vite build --config vite.hosted.config.ts && node scripts/prepare-artifact.mjs dist-hosted"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "hono": "4.12.10",
    "jspdf": "3.0.1",
    "lucide-react": "^0.577.0",
    "nodemailer": "10.0.10",
    "pdfjs-dist": "6.0.227",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.5.0",
    "wouter": "3.9.0",
    "xlsx": "^0.18.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/bun": "latest",
    "@types/node": "^25.3.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
